# JanSahayak AI — Environment Configuration Example

# Google Gemini API Key (Get yours at https://aistudio.google.com/)
GEMINI_API_KEY=

# Configured Gemini model (Default: gemini-3.5-flash-lite, fallback: gemini-3.8-flash, gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash-lite

# Allowed Frontend Origins for CORS
FRONTEND_ORIGIN=http://localhost:5173
BACKEND_URL=http://127.0.0.1:8000

# Data and Vector Index Directories
DATA_DIR=./data
VECTOR_INDEX_DIR=./data/vector_index

# Sentence Transformers Dense Embedding Model for Semantic Search
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
SIMILARITY_THRESHOLD=0.20
TOP_K_RETRIEVAL=4

# Logging Verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO